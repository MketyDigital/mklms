# MkLMS application environment template
# Authoritative host-by-host guide: docs/deployment/environment-variables.md
# Three-Worker Cloudflare setup checklist: .env.cloudflare.example

# Required PostgreSQL persistence / fallback
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=require
DATABASE_POOL_MAX=5

# Required built-in administrator authentication
MKLMS_ADMIN_ACCESS_KEY=replace-with-a-long-random-admin-key
MKLMS_ADMIN_SESSION_SECRET=replace-with-a-different-long-random-session-secret
# Optional; defaults to 28800 seconds (8 hours)
MKLMS_ADMIN_SESSION_TTL_SECONDS=28800

# Optional built-in student access/session fallbacks.
# platform_settings can override access-code prefix and claim strategy.
MKLMS_ACCESS_CODE_PREFIX=ACCESS
MKLMS_CLAIM_VERIFICATION_STRATEGY=preauth-only
MKLMS_STUDENT_SESSION_TTL_SECONDS=1209600

# Protected private video delivery (required when DIRECT/HLS private playback is used)
# Base URL is the deployed protected media Worker/custom media domain, NOT the R2 S3 endpoint.
MKLMS_MEDIA_DELIVERY_BASE_URL=
MKLMS_MEDIA_SIGNING_SECRET=

# Optional S3-compatible application storage (R2, S3, MinIO, etc.)
# This remains the portable path for certificates/general private objects on the main app.
MKLMS_STORAGE_BUCKET=
MKLMS_STORAGE_REGION=auto
MKLMS_STORAGE_ENDPOINT=
MKLMS_STORAGE_ACCESS_KEY_ID=
MKLMS_STORAGE_SECRET_ACCESS_KEY=
MKLMS_STORAGE_FORCE_PATH_STYLE=false

# Optional OCI Media Flow -> R2 automation.
# Keep false for direct H.264/AAC MP4 and local/operator upload workflows.
MKLMS_OCI_MEDIA_AUTOMATION_ENABLED=false
MKLMS_OCI_SOURCE_BUCKET=
MKLMS_OCI_OUTPUT_BUCKET=
MKLMS_OCI_MEDIA_WORKFLOW_ID=
MKLMS_R2_MEDIA_BUCKET=spf-media

# Local/operator R2 upload helper credentials only; not used by the media Worker binding.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional managed-hosting usage/billing display and manual operator controls.
MKLMS_MANAGED_HOSTING_ENABLED=false
MKLMS_MANAGED_HOSTING_MIN_USD=15
MKLMS_MANAGED_HOSTING_MAX_USD=50
MKLMS_MANAGED_HOSTING_OPERATOR_KEY=replace-with-a-separate-long-operator-key
# Optional fallback link when automatic billing is not configured.
MKLMS_MANAGED_PAYMENT_URL=https://example.com/pay
MKLMS_MANAGED_HOSTING_NOTICE=

# Optional reusable automatic billing Worker integration.
MKLMS_BILLING_SERVICE_URL=
MKLMS_BILLING_INSTALLATION_ID=spf-mklms
MKLMS_BILLING_SHARED_SECRET=replace-with-a-long-per-installation-shared-secret

# Optional notifications
MKLMS_TELEGRAM_BOT_TOKEN=
MKLMS_TELEGRAM_CHAT_ID=

# Optional SMTP email
MKLMS_EMAIL_PROVIDER=none
MKLMS_SMTP_HOST=
MKLMS_SMTP_PORT=587
MKLMS_SMTP_SECURE=false
MKLMS_SMTP_USER=
MKLMS_SMTP_PASSWORD=
MKLMS_EMAIL_FROM=

# Cloudflare-only bindings are NOT environment variables and are intentionally absent here:
# Main Worker: HYPERDRIVE_FRESH, HYPERDRIVE_CACHED, ASSETS.
# Media Worker: MEDIA_BUCKET -> private R2 bucket spf-media.

# Billing Worker-only secrets (configure on workers/billing, not on the normal app):
# NOWPAYMENTS_API_KEY=<reuse the existing legacy Mkety secret value>
# NOWPAYMENTS_IPN_SECRET=<reuse the existing legacy Mkety secret value>
# MKETY_BILLING_CUSTOMERS_JSON=<secret customer registry JSON>
