# Required for real MkLMS persistence
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=require
DATABASE_POOL_MAX=5

# Built-in administrator authentication
MKLMS_ADMIN_ACCESS_KEY=replace-with-a-long-random-admin-key
MKLMS_ADMIN_SESSION_SECRET=replace-with-a-different-long-random-session-secret

# Optional S3-compatible private storage (R2, S3, MinIO, etc.)
# Cloudflare can instead use a native application-storage R2 binding once configured.
MKLMS_STORAGE_BUCKET=
MKLMS_STORAGE_REGION=auto
MKLMS_STORAGE_ENDPOINT=
MKLMS_STORAGE_ACCESS_KEY_ID=
MKLMS_STORAGE_SECRET_ACCESS_KEY=
MKLMS_STORAGE_FORCE_PATH_STYLE=false

# Optional protected media delivery adapter
MKLMS_MEDIA_DELIVERY_BASE_URL=
MKLMS_MEDIA_SIGNING_SECRET=

# Optional OCI Media Flow -> R2 automation.
MKLMS_OCI_MEDIA_AUTOMATION_ENABLED=false
MKLMS_OCI_SOURCE_BUCKET=
MKLMS_OCI_OUTPUT_BUCKET=
MKLMS_OCI_MEDIA_WORKFLOW_ID=
MKLMS_R2_MEDIA_BUCKET=

# Local/operator R2 upload credentials (not needed by a Worker using an R2 binding)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional managed-hosting usage/billing display and manual operator controls
MKLMS_MANAGED_HOSTING_ENABLED=false
MKLMS_MANAGED_HOSTING_MIN_USD=15
MKLMS_MANAGED_HOSTING_MAX_USD=50
MKLMS_MANAGED_HOSTING_OPERATOR_KEY=replace-with-a-separate-long-operator-key
MKLMS_MANAGED_PAYMENT_URL=https://example.com/pay
MKLMS_MANAGED_HOSTING_NOTICE=

# Optional reusable automatic billing Worker integration.
# Existing MKLMS_MANAGED_PAYMENT_URL remains the fallback when these are absent.
MKLMS_BILLING_SERVICE_URL=
MKLMS_BILLING_INSTALLATION_ID=spf-mklms
MKLMS_BILLING_SHARED_SECRET=replace-with-a-long-per-installation-shared-secret

# Optional notifications
MKLMS_TELEGRAM_BOT_TOKEN=
MKLMS_TELEGRAM_CHAT_ID=

# Optional SMTP email
MKLMS_EMAIL_PROVIDER=none
MKLMS_SMTP_HOST=
MKLMS_SMTP_PORT=587
MKLMS_SMTP_SECURE=false
MKLMS_SMTP_USER=
MKLMS_SMTP_PASSWORD=
MKLMS_EMAIL_FROM=

# Billing Worker-only secrets (set on the standalone billing Worker, not the normal app):
# NOWPAYMENTS_API_KEY=<reuse the existing legacy Mkety secret value>
# NOWPAYMENTS_IPN_SECRET=<reuse the existing legacy Mkety secret value>
# MKETY_BILLING_CUSTOMERS_JSON=<secret JSON customer registry>
