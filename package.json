    "nodemailer": "^7.0.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
