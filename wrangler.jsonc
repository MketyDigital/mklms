{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mklms",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run cf:build"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }

  // Hyperdrive is a Cloudflare binding, not a normal environment variable.
  // Keep this template commented until the two configurations are created in
  // your Cloudflare account. Then replace the example IDs with the IDs that
  // Cloudflare returns and uncomment the block. Never commit database passwords.
  //
  // "hyperdrive": [
  //   {
  //     "binding": "HYPERDRIVE_FRESH",
  //     "id": "<fresh-hyperdrive-config-id>"
  //   },
  //   {
  //     "binding": "HYPERDRIVE_CACHED",
  //     "id": "<cached-hyperdrive-config-id>"
  //   }
  // ]
}
