# MkLMS Cloudflare deployment reference for ALL THREE Workers.
# This file is a setup/reference file only. Do not commit real secrets.
# It is intentionally separate from the general .env.example.
#
# Cloudflare current monorepo pattern:
# - Connect the same GitHub repo to each Worker.
# - Keep repository root as the build root for this repo.
# - Use the explicit Wrangler config path in each auxiliary Worker deploy command.
#
# Worker 1: mklms (main LMS app)
# Worker 2: mklms-media-delivery (protected video adapter)
# Worker 3: mkety-managed-hosting-billing (reusable NOWPayments billing service)

###############################################################################
# WORKER 1 — MAIN MKLMS APP (Cloudflare Worker)
###############################################################################
# Cloudflare dashboard Worker name: mklms
# GitHub repo: MketyDigital/mklms
# Root directory: /
# Build command: npm run cf:build
# Deploy command: npx opennextjs-cloudflare deploy
# Production branch: main
# Node: 24.x
#
# ALREADY DECLARED AS CLOUDFLARE BINDINGS IN wrangler.jsonc — DO NOT CREATE
# THESE AS STRING ENV VARS:
# - ASSETS
# - HYPERDRIVE_FRESH -> bb7c9f70c2fe402080c22e06d0c0f305
# - HYPERDRIVE_CACHED -> 14a4baf3773d41c88e4600967ab3b68d
#
# NOT YET A MAIN-WORKER R2 BINDING:
# - certificate/general application storage still uses the portable S3-compatible
#   StorageProvider today. Use MKLMS_STORAGE_* below if certificates/private files
#   need storage. Protected video is handled separately by Worker 2.

# PostgreSQL fallback/build/migration connection.
# Runtime on Cloudflare prefers HYPERDRIVE_FRESH/HYPERDRIVE_CACHED when available.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=require
DATABASE_POOL_MAX=5

# Built-in admin authentication — REQUIRED in production.
MKLMS_ADMIN_ACCESS_KEY=replace-with-a-long-random-admin-key
MKLMS_ADMIN_SESSION_SECRET=replace-with-a-different-long-random-session-secret
MKLMS_ADMIN_SESSION_TTL_SECONDS=28800

# Built-in student auth/session defaults — optional because code/database defaults exist.
MKLMS_ACCESS_CODE_PREFIX=ACCESS
MKLMS_CLAIM_VERIFICATION_STRATEGY=preauth-only
MKLMS_STUDENT_SESSION_TTL_SECONDS=1209600

# Protected video integration with Worker 2 — REQUIRED when using private DIRECT/HLS media.
# Set this AFTER Worker 2 is deployed and you know its workers.dev/custom-domain URL.
MKLMS_MEDIA_DELIVERY_BASE_URL=https://mklms-media-delivery.YOUR_SUBDOMAIN.workers.dev
# Must be EXACTLY the same secret configured on Worker 2.
MKLMS_MEDIA_SIGNING_SECRET=replace-with-a-long-random-media-signing-secret

# General/certificate private storage — currently S3-compatible and portable.
# These ARE still needed if you use certificate/general object storage on the main app.
# For Cloudflare R2, endpoint is https://ACCOUNT_ID.r2.cloudflarestorage.com
MKLMS_STORAGE_BUCKET=
MKLMS_STORAGE_REGION=auto
MKLMS_STORAGE_ENDPOINT=
MKLMS_STORAGE_ACCESS_KEY_ID=
MKLMS_STORAGE_SECRET_ACCESS_KEY=
MKLMS_STORAGE_FORCE_PATH_STYLE=false

# OCI Media Flow automation — leave false for the current direct-MP4/local-upload path.
MKLMS_OCI_MEDIA_AUTOMATION_ENABLED=false
MKLMS_OCI_SOURCE_BUCKET=
MKLMS_OCI_OUTPUT_BUCKET=
MKLMS_OCI_MEDIA_WORKFLOW_ID=
MKLMS_R2_MEDIA_BUCKET=spf-media

# Managed-hosting billing display + manual operator controls.
# Set true to show Admin -> Hosting & Usage managed billing panel.
MKLMS_MANAGED_HOSTING_ENABLED=true
MKLMS_MANAGED_HOSTING_MIN_USD=15
MKLMS_MANAGED_HOSTING_MAX_USD=50
# Separate from normal admin login. Required to manually set PENDING/PAID/WAIVED.
MKLMS_MANAGED_HOSTING_OPERATOR_KEY=replace-with-a-separate-long-operator-key
# Optional fallback link if automatic billing is not configured.
MKLMS_MANAGED_PAYMENT_URL=
MKLMS_MANAGED_HOSTING_NOTICE=

# Automatic managed-hosting billing integration with Worker 3.
# Set AFTER Worker 3 is deployed and you know its URL.
MKLMS_BILLING_SERVICE_URL=https://mkety-managed-hosting-billing.YOUR_SUBDOMAIN.workers.dev/
MKLMS_BILLING_INSTALLATION_ID=spf-mklms
# Unique to this LMS installation. Must exactly match this customer's sharedSecret
# inside Worker 3's MKETY_BILLING_CUSTOMERS_JSON.
MKLMS_BILLING_SHARED_SECRET=replace-with-a-long-unique-installation-secret

# Optional Telegram notifications.
MKLMS_TELEGRAM_BOT_TOKEN=
MKLMS_TELEGRAM_CHAT_ID=

# Optional email.
MKLMS_EMAIL_PROVIDER=none
MKLMS_SMTP_HOST=
MKLMS_SMTP_PORT=587
MKLMS_SMTP_SECURE=false
MKLMS_SMTP_USER=
MKLMS_SMTP_PASSWORD=
MKLMS_EMAIL_FROM=

###############################################################################
# WORKER 2 — PROTECTED MEDIA DELIVERY
###############################################################################
# Cloudflare dashboard Worker name MUST match workers/media-delivery/wrangler.jsonc:
# mklms-media-delivery
# GitHub repo: MketyDigital/mklms
# Recommended root directory for this repo: /
# Build command: leave blank (no separate compile step required)
# Deploy command:
# npx wrangler deploy --config workers/media-delivery/wrangler.jsonc
# Optional preview/non-production deploy command:
# npx wrangler versions upload --config workers/media-delivery/wrangler.jsonc
#
# ALREADY DECLARED/BINDED IN workers/media-delivery/wrangler.jsonc:
# - MEDIA_BUCKET -> R2 bucket: spf-media
#
# DO NOT ADD R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY TO THIS WORKER.
# The native MEDIA_BUCKET binding gives it private R2 access directly.

# REQUIRED Worker 2 secret — same value as main app MKLMS_MEDIA_SIGNING_SECRET.
MKLMS_MEDIA_SIGNING_SECRET=replace-with-the-exact-same-media-signing-secret-used-on-main

# Optional exact-origin CORS allowlist. HMAC auth remains mandatory regardless.
# Example once your final LMS domain is known:
MKLMS_MEDIA_ALLOWED_ORIGINS=https://YOUR_LMS_DOMAIN

###############################################################################
# WORKER 3 — REUSABLE NOWPAYMENTS BILLING WORKER
###############################################################################
# Cloudflare dashboard Worker name MUST match workers/billing/wrangler.jsonc:
# mkety-managed-hosting-billing
# GitHub repo: MketyDigital/mklms
# Recommended root directory for this repo: /
# Build command: leave blank
# Deploy command:
# npx wrangler deploy --config workers/billing/wrangler.jsonc
# Optional preview/non-production deploy command:
# npx wrangler versions upload --config workers/billing/wrangler.jsonc
#
# CLOUDFLARE BINDINGS:
# - none currently required
# DATABASE:
# - none required
# R2:
# - none required

# Reuse the SAME existing NOWPayments merchant secret values used by legacy Mkety.
NOWPAYMENTS_API_KEY=replace-with-existing-legacy-mkety-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=replace-with-existing-legacy-mkety-nowpayments-ipn-secret

# Secret JSON registry for every managed installation served by this Worker.
# Keep this as a Worker SECRET, not a public/plain variable.
# For the current LMS the shape is:
# {
#   "spf-mklms": {
#     "settlementUrl": "https://YOUR_LMS_DOMAIN/api/managed-hosting/settlement",
#     "sharedSecret": "SAME_AS_MAIN_MKLMS_BILLING_SHARED_SECRET",
#     "successUrl": "https://YOUR_LMS_DOMAIN/admin/hosting?payment=success",
#     "cancelUrl": "https://YOUR_LMS_DOMAIN/admin/hosting?payment=cancelled"
#   }
# }
MKETY_BILLING_CUSTOMERS_JSON={}

###############################################################################
# CLOUDFLARE R2 BUCKET SETTINGS FOR spf-media
###############################################################################
# Bucket: spf-media
# Public Access: DISABLED (keep disabled)
# Local Uploads: optional; may be enabled to improve upload performance/reliability
# from your location. It is not required for playback security.
#
# Worker binding already in code:
# mklms-media-delivery: MEDIA_BUCKET -> spf-media
#
# The MAIN mklms Worker is NOT currently bound to spf-media for certificate/general
# object storage. Protected video does not need the main Worker to have the R2 binding.

###############################################################################
# LOCAL / OPERATOR-ONLY R2 CREDENTIALS
###############################################################################
# These are NOT runtime variables for Worker 2.
# Use them only for Cyberduck, rclone, upload scripts or another S3 client.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# S3 endpoint pattern:
# https://ACCOUNT_ID.r2.cloudflarestorage.com

###############################################################################
# IF THE MAIN LMS IS HOSTED OUTSIDE CLOUDFLARE (VERCEL / OCI / VPS / DOCKER)
###############################################################################
# Use the same main-app variables above, especially:
# DATABASE_URL
# DATABASE_SSL
# DATABASE_POOL_MAX
# MKLMS_ADMIN_ACCESS_KEY
# MKLMS_ADMIN_SESSION_SECRET
# MKLMS_MEDIA_DELIVERY_BASE_URL
# MKLMS_MEDIA_SIGNING_SECRET
# MKLMS_BILLING_SERVICE_URL
# MKLMS_BILLING_INSTALLATION_ID
# MKLMS_BILLING_SHARED_SECRET
# optional SMTP/Telegram/managed-hosting settings
#
# DO NOT configure Cloudflare-only bindings on Vercel/OCI/VPS:
# - ASSETS
# - HYPERDRIVE_FRESH
# - HYPERDRIVE_CACHED
#
# A Vercel/OCI-hosted main LMS can still use Worker 2 + spf-media and Worker 3
# exactly as they are. The only difference is the main application connects to
# PostgreSQL through DATABASE_URL rather than Hyperdrive.

###############################################################################
# IF THE MEDIA ADAPTER IS EVER HOSTED OUTSIDE CLOUDFLARE
###############################################################################
# The CURRENT media adapter implementation is Cloudflare-specific because it uses
# the native MEDIA_BUCKET R2 binding. A non-Cloudflare replacement adapter would
# need S3-compatible R2 credentials instead, for example:
# R2 endpoint / Access Key ID / Secret Access Key / bucket name.
# MKLMS itself would only need MKLMS_MEDIA_DELIVERY_BASE_URL changed to the new
# adapter URL; paid-course/live authorization logic does not need redesign.

###############################################################################
# IF THE BILLING SERVICE IS EVER HOSTED OUTSIDE CLOUDFLARE
###############################################################################
# The billing service is much more portable. Preserve these three secrets/configs:
# NOWPAYMENTS_API_KEY
# NOWPAYMENTS_IPN_SECRET
# MKETY_BILLING_CUSTOMERS_JSON
# Then change each customer's MKLMS_BILLING_SERVICE_URL to the new service URL.
