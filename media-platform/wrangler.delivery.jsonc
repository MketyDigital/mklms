{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mkety-media-assets",
  "main": "workers/delivery.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "analytics_engine_datasets": [
    { "binding": "MEDIA_USAGE_ANALYTICS", "dataset": "mkety_media_usage" }
  ],
  "kv_namespaces": [
    {
      "binding": "BUCKET_DIRECTORY",
      "id": "REPLACE_WITH_MEDIA_BUCKET_DIRECTORY_KV_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_R2_BUCKET",
      "bucket_name": "REPLACE_WITH_MEDIA_R2_BUCKET"
    }
  ]
}
