# Mkety Media V1 configuration
# Real secret values belong in Cloudflare Worker secrets / GitHub repository secrets, never here.

# R2 default pool
MEDIA_R2_ENABLED=true
MEDIA_R2_S3_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
MEDIA_R2_S3_REGION=auto
MEDIA_R2_S3_BUCKET=<mkety-media-r2-bucket>
MEDIA_R2_S3_ACCESS_KEY_ID=<secret>
MEDIA_R2_S3_SECRET_ACCESS_KEY=<secret>

# Portal operator
MEDIA_OPERATOR_ACCESS_KEY=<long-random-secret>
MEDIA_OPERATOR_SESSION_SECRET=<32+-byte-random-secret>

# NOWPayments (existing crypto option)
NOWPAYMENTS_API_KEY=<secret>
NOWPAYMENTS_IPN_SECRET=<secret>

# Flutterwave (automated fiat checkout)
# Configure /api/billing/flutterwave/webhook in the Flutterwave dashboard
# and use the same random secret hash in Flutterwave and this environment.
FLUTTERWAVE_SECRET_KEY=<secret>
FLUTTERWAVE_SECRET_HASH=<random-webhook-secret-hash>

# Kora (automated fiat/local-method checkout)
# Kora receives the per-transaction notification URL automatically.
KORA_SECRET_KEY=<secret>

# Telegram bank-transfer approval
MEDIA_TELEGRAM_BOT_TOKEN=<secret>
MEDIA_TELEGRAM_CHAT_ID=<operator-chat-id>
MEDIA_TELEGRAM_WEBHOOK_SECRET=<long-random-secret>
MEDIA_TELEGRAM_OPERATOR_IDS=<telegram-user-id-1,telegram-user-id-2>

# Optional OCI Enterprise pool
MEDIA_OCI_ENABLED=false
MEDIA_OCI_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
MEDIA_OCI_REGION=af-johannesburg-1
MEDIA_OCI_BUCKET=<bucket>
MEDIA_OCI_ACCESS_KEY_ID=<customer-secret-access-key>
MEDIA_OCI_SECRET_ACCESS_KEY=<customer-secret-secret-key>

# Optional AWS S3 Enterprise pool
MEDIA_AWS_ENABLED=false
MEDIA_AWS_REGION=<region>
MEDIA_AWS_BUCKET=<bucket>
MEDIA_AWS_ACCESS_KEY_ID=<secret>
MEDIA_AWS_SECRET_ACCESS_KEY=<secret>

# Optional Google Cloud Storage interoperability pool
MEDIA_GCS_ENABLED=false
MEDIA_GCS_BUCKET=<bucket>
MEDIA_GCS_ACCESS_KEY_ID=<hmac-access-id>
MEDIA_GCS_SECRET_ACCESS_KEY=<hmac-secret>

# Optional Backblaze B2 S3 pool
MEDIA_BACKBLAZE_ENABLED=false
MEDIA_BACKBLAZE_ENDPOINT=<s3-endpoint>
MEDIA_BACKBLAZE_REGION=<region>
MEDIA_BACKBLAZE_BUCKET=<bucket>
MEDIA_BACKBLAZE_ACCESS_KEY_ID=<secret>
MEDIA_BACKBLAZE_SECRET_ACCESS_KEY=<secret>

# Optional Wasabi pool
MEDIA_WASABI_ENABLED=false
MEDIA_WASABI_ENDPOINT=<s3-endpoint>
MEDIA_WASABI_REGION=<region>
MEDIA_WASABI_BUCKET=<bucket>
MEDIA_WASABI_ACCESS_KEY_ID=<secret>
MEDIA_WASABI_SECRET_ACCESS_KEY=<secret>

# Optional DigitalOcean Spaces pool
MEDIA_DIGITALOCEAN_ENABLED=false
MEDIA_DIGITALOCEAN_ENDPOINT=<spaces-endpoint>
MEDIA_DIGITALOCEAN_REGION=<region>
MEDIA_DIGITALOCEAN_BUCKET=<space>
MEDIA_DIGITALOCEAN_ACCESS_KEY_ID=<secret>
MEDIA_DIGITALOCEAN_SECRET_ACCESS_KEY=<secret>

# Optional Azure Blob Enterprise pool
MEDIA_AZURE_ENABLED=false
MEDIA_AZURE_ACCOUNT_NAME=<account>
MEDIA_AZURE_CONTAINER=<container>
MEDIA_AZURE_ACCOUNT_KEY=<secret>

# Maintenance Worker only
CLOUDFLARE_ACCOUNT_ID=<existing-repo-secret>
CLOUDFLARE_API_TOKEN=<existing-repo-secret>
