{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mkety-media",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "npm run cf:build" },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "MEDIA_DB",
      "database_name": "mkety-media",
      "database_id": "REPLACE_WITH_MEDIA_D1_ID"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "BUCKET_DIRECTORY",
      "id": "REPLACE_WITH_MEDIA_BUCKET_DIRECTORY_KV_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_R2_BUCKET",
      "bucket_name": "REPLACE_WITH_MEDIA_R2_BUCKET"
    }
  ]
}
